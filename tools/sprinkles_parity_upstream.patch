+
+fn parity_capture(
+    mut commands: Commands,
+    time: Res<Time>,
+    state: Res<state::EditorState>,
+    emitters: Query<&bevy_sprinkles::prelude::EmitterRuntime>,
+    mut start: Local<Option<f64>>,
+    mut stage: Local<usize>,
+    mut exit: MessageWriter<AppExit>,
+) {
+    if state.current_project.is_none() || emitters.is_empty() { return; }
+    let started = *start.get_or_insert(time.elapsed_secs_f64());
+    let elapsed = time.elapsed_secs_f64() - started;
+    if *stage < 3 && elapsed >= [3., 6., 9.][*stage] {
+        let path = std::path::PathBuf::from(std::env::var_os("SPRINKLES_PARITY_OUTPUT").expect("parity output"));
+        commands.spawn(bevy::render::view::screenshot::Screenshot::primary_window())
+            .observe(bevy::render::view::screenshot::save_to_disk(path.join(format!("capture-{}.png", *stage))));
+        *stage += 1;
+    }
+    if *stage == 3 && elapsed > 12. { exit.write(AppExit::Success); }
+}
